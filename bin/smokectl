#!/usr/bin/env bash
# smokectl: operator CLI (run from your laptop; needs `gh auth login`, optionally gcloud).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../smoke.config.env
source "$ROOT/smoke.config.env"
CTRL="$OWNER/$CONTROL_REPO_NAME"

usage() {
  cat <<EOF
smokectl <command> [args]

  enable  <repo>          opt a repo in (adds topic '$OPT_IN_TOPIC'; poller deploys every new default-branch commit)
  disable <repo>          opt a repo out (removes topic; does not tear down)
  deploy  <repo> [ref]    run gate + deploy now (ref = branch/tag/sha; default branch if omitted)
  teardown <repo>         delete the Cloud Run service, its GCP secrets, runtime SA and images
  runs    [repo]          recent pipeline runs
  status                  live smoke apps and URLs (needs gcloud)
  secrets <repo>          where to put this app's API keys/credentials in Infisical

DefectDojo (findings tracker on the VM, reached through Google IAP; see README "DefectDojo"):
  grant-dojo  <email>     let a teammate open DefectDojo (IAP tunnel to port $DEFECTDOJO_PORT only; no SSH, no VM admin)
  revoke-dojo <email>     remove that access
  dojo-tunnel             open the tunnel yourself, then browse $DEFECTDOJO_UI_URL
  dojo-status             health of DefectDojo on the VM (over SSH; needs your VM access)
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  enable)   gh repo edit "$OWNER/${1:?repo}" --add-topic "$OPT_IN_TOPIC" && echo "enabled; deploys on next poll (≤30 min) or run: smokectl deploy $1" ;;
  disable)  gh repo edit "$OWNER/${1:?repo}" --remove-topic "$OPT_IN_TOPIC" ;;
  deploy)   gh workflow run deploy.yml -R "$CTRL" -f repo="${1:?repo}" -f ref="${2:-}" && echo "dispatched; watch: gh run watch -R $CTRL" ;;
  teardown) gh workflow run teardown.yml -R "$CTRL" -f repo="${1:?repo}" ;;
  runs)     if [[ -n "${1:-}" ]]; then gh run list -R "$CTRL" -w deploy.yml -L 50 | grep -F "smoke: $1 " || true
            else gh run list -R "$CTRL" -w deploy.yml -L 20; fi ;;
  status)   gcloud run services list --project "$GCP_PROJECT" --region "$GCP_REGION" \
              --filter="metadata.labels.managed-by=smoke-landing" \
              --format="table(metadata.name, metadata.labels.commit, status.url, metadata.labels.deployed-at.date(tz=LOCAL))" ;;
  secrets)  r="${1:?repo}"; p="/$(echo "$r" | sed -E 's/[^A-Za-z0-9_-]/-/g')"
            cat <<EOF
Infisical UI: $INFISICAL_UI_URL   (ssh -L 8080:localhost:8080 <vm>)
  Project:     $INFISICAL_PROJECT_ID
  Environment: $INFISICAL_ENV
  Folder:      $p          <- create it and add KEY=value pairs (env-var style names)
Shared keys (e.g. one OPENAI_API_KEY for many apps): put them in /_shared and add a
"secret import" of /_shared into $p.  Changes apply on the next deploy: smokectl deploy $r
EOF
            ;;
  grant-dojo)
    e="${1:?email}"; vm="projects/$GCP_PROJECT/zones/$VM_ZONE/instances/$VM_NAME"
    # IAP tunnel to the DefectDojo port ONLY (not 22: no SSH through IAP)
    gcloud projects add-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" --role roles/iap.tunnelResourceAccessor \
      --condition "expression=destination.port == $DEFECTDOJO_PORT,title=defectdojo-iap-port-only" >/dev/null
    # gcloud looks the VM up by name before tunnelling: compute.instances.get on this one VM
    gcloud projects add-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" \
      --role "projects/$GCP_PROJECT/roles/smokeDojoTunnel" \
      --condition "expression=resource.name == '$vm',title=defectdojo-vm-lookup" >/dev/null
    cat <<MSG
Granted $e IAP access to DefectDojo (port $DEFECTDOJO_PORT only). Send them:
  1. Install the Google Cloud SDK (Windows: "Google Cloud SDK Shell"), then run once:  gcloud auth login
  2. Each time:  gcloud compute start-iap-tunnel $VM_NAME $DEFECTDOJO_PORT --local-host-port=localhost:$DEFECTDOJO_PORT --zone $VM_ZONE --project $GCP_PROJECT
  3. Leave that window open and browse $DEFECTDOJO_UI_URL
They also need a DefectDojo login: on the VM run  sudo $DEFECTDOJO_DIR/add-user.sh $e
MSG
    ;;
  revoke-dojo)
    e="${1:?email}"
    for r in roles/iap.tunnelResourceAccessor "projects/$GCP_PROJECT/roles/smokeDojoTunnel"; do
      if gcloud projects remove-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" --role "$r" --all >/dev/null 2>&1; then
        echo "removed $r"; else echo "no $r binding for $e"; fi
    done
    echo "Also deactivate their DefectDojo login (Users page, as admin) if they shouldn't sign in again." ;;
  dojo-tunnel)
    echo "Tunnel open while this runs; browse $DEFECTDOJO_UI_URL (Ctrl+C to close)."
    gcloud compute start-iap-tunnel "$VM_NAME" "$DEFECTDOJO_PORT" --local-host-port="localhost:$DEFECTDOJO_PORT" \
      --zone "$VM_ZONE" --project "$GCP_PROJECT" ;;
  dojo-status)
    if [[ -x "$DEFECTDOJO_DIR/status.sh" ]]; then sudo "$DEFECTDOJO_DIR/status.sh"
    else gcloud compute ssh "$VM_NAME" --zone "$VM_ZONE" --project "$GCP_PROJECT" --command "sudo $DEFECTDOJO_DIR/status.sh"; fi ;;
  *) usage; [[ -z "$cmd" ]] || exit 1 ;;
esac
