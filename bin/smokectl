#!/usr/bin/env bash
# smokectl: operator CLI. Plain bash: runs in Git Bash or WSL on Windows, in Cloud Shell, or on the VM.
# Needs `gh auth login` (GitHub) and `gcloud auth login` (Google Cloud) for the commands that use them.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# lib.sh: smoke.config.env + name helpers (slug, label_val, ...). It does NOT need runner.env.
# shellcheck source=../scripts/lib.sh
source "$ROOT/scripts/lib.sh"
CTRL="$OWNER/$CONTROL_REPO_NAME"
G=(--project "$GCP_PROJECT" --quiet)

usage() {
  cat <<EOF
smokectl <command> [args]

Pipeline
  enable  <repo>                 opt a repo in (topic '$OPT_IN_TOPIC'; every new default-branch commit is gated + staged)
  disable <repo>                 opt a repo out (removes the topic; does not tear down)
  deploy  <repo> [ref]           run gate + staging now (ref = branch/tag/sha; default branch if omitted)
  runs    [repo]                 recent pipeline runs
  status                         live staging apps and URLs
  teardown <repo>                delete the staging service, runtime SA and staging images (secrets are kept)

Release (staging -> release registry the boundary pulls from)
  release  <repo> <sha> "<why>"  promote a commit that passed staging (verified, signed, recorded)
  releases [repo]                released images + the exact boundary reference (@sha256:...)

Secrets (Google Secret Manager; values are typed hidden and never printed)
  secret set  <repo> KEY         add/replace an app secret (env var KEY in staging)
  secret set  --shared KEY       add/replace a shared secret (apps opt in via .smoke.yml shared_secrets)
  secret list <repo>|--shared    names and last update, never values
  secret rm   <repo> KEY         delete an app secret
  grant-secrets  <email>         let a teammate add/rotate secrets without being able to read them
  revoke-secrets <email>

DefectDojo (findings tracker on the VM, reached through Google IAP)
  grant-dojo  <email>            IAP tunnel to port $DEFECTDOJO_PORT only (no SSH, no VM admin)
  revoke-dojo <email>
  dojo-tunnel                    open the tunnel yourself, then browse $DEFECTDOJO_UI_URL
  dojo-status                    health of DefectDojo on the VM (over SSH)
EOF
}

valid_key()  { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && "$1" != PORT && "$1" != K_* ]] || die "KEY must be an env var name (not PORT or K_*): '$1'"; }
secret_ref() {   # <repo>|--shared KEY -> sets SNAME SLABELS
  if [[ "$1" == --shared ]]; then SNAME="smoke-shared-$2"; SLABELS="managed-by=smoke-landing,smoke-shared=true"
  else validate_repo "$1"; SNAME="$(secret_name "$1" "$2")"; SLABELS="managed-by=smoke-landing,smoke-app=$(label_val "$1")"; fi
}

secret_cmd() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    set)
      local who="${1:?repo or --shared}" key="${2:?KEY}" val=""; valid_key "$key"; secret_ref "$who" "$key"
      if [[ -t 0 ]]; then
        read -rs -p "Value for $key (hidden): " val; echo >&2
        local again; read -rs -p "Again: " again; echo >&2
        [[ "$val" == "$again" ]] || die "values differ"
      else
        IFS= read -r -d '' val || true    # piped in, e.g. from a password manager CLI
        val="${val%$'\n'}"
      fi
      [[ -n "$val" ]] || die "empty value"
      gcloud secrets describe "$SNAME" "${G[@]}" >/dev/null 2>&1 || \
        gcloud secrets create "$SNAME" "${G[@]}" --replication-policy automatic --labels "$SLABELS" >/dev/null
      printf '%s' "$val" | gcloud secrets versions add "$SNAME" "${G[@]}" --data-file=- >/dev/null
      unset val
      echo "Saved $SNAME. It reaches staging on the next deploy$([[ "$who" == --shared ]] && echo " of apps listing $key under shared_secrets in .smoke.yml" || echo ": smokectl deploy $who")."
      ;;
    list)
      local who="${1:?repo or --shared}" filter
      if [[ "$who" == --shared ]]; then filter="labels.smoke-shared=true"; else validate_repo "$who"; filter="labels.smoke-app=$(label_val "$who")"; fi
      gcloud secrets list "${G[@]}" --filter "$filter" --format "table(name.basename():label=SECRET, createTime.date(tz=LOCAL):label=CREATED)"
      echo "(Values are never shown. Version history: gcloud secrets versions list <SECRET> --project $GCP_PROJECT)"
      ;;
    rm)
      local who="${1:?repo}" key="${2:?KEY}"; valid_key "$key"; secret_ref "$who" "$key"
      read -r -p "Delete $SNAME and all its versions? [y/N] " a; [[ "$a" == [yY] ]] || exit 0
      gcloud secrets delete "$SNAME" "${G[@]}" ;;
    *) usage; exit 1 ;;
  esac
}

cmd="${1:-}"; shift || true
case "$cmd" in
  enable)   gh repo edit "$OWNER/${1:?repo}" --add-topic "$OPT_IN_TOPIC" && echo "enabled; deploys on next poll (≤30 min) or run: smokectl deploy $1" ;;
  disable)  gh repo edit "$OWNER/${1:?repo}" --remove-topic "$OPT_IN_TOPIC" ;;
  deploy)   gh workflow run deploy.yml -R "$CTRL" -f repo="${1:?repo}" -f ref="${2:-}" && echo "dispatched; watch: gh run watch -R $CTRL" ;;
  teardown) gh workflow run teardown.yml -R "$CTRL" -f repo="${1:?repo}" ;;
  runs)     if [[ -n "${1:-}" ]]; then gh run list -R "$CTRL" -L 50 | grep -E "(smoke|release): $1 " || true
            else gh run list -R "$CTRL" -L 20; fi ;;
  status)   gcloud run services list "${G[@]}" --region "$GCP_REGION" \
              --filter="metadata.labels.managed-by=smoke-landing" \
              --format="table(metadata.name, metadata.labels.commit, status.url, metadata.labels.deployed-at.date(tz=LOCAL))" ;;

  release)
    r="${1:?repo}"; sha="${2:?commit sha}"; why="${3:?justification in quotes}"
    gh workflow run release.yml -R "$CTRL" -f repo="$r" -f commit="$sha" -f justification="$why" \
      && echo "dispatched; watch: gh run watch -R $CTRL   (the run summary shows the boundary reference)" ;;
  releases)
    path="$(ar_host)/$GCP_PROJECT/$RELEASE_REPO"; [[ -n "${1:-}" ]] && path+="/$(slug "$1")"
    gcloud artifacts docker images list "$path" "${G[@]}" --include-tags \
      --format="table[no-heading](package.basename():label=APP, tags.list():label=COMMIT, createTime.date(tz=LOCAL):label=RELEASED, format('{0}@{1}', package, version):label=BOUNDARY_REFERENCE)" ;;

  secret) secret_cmd "$@" ;;
  grant-secrets)
    gcloud projects add-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:${1:?email}" \
      --role "projects/$GCP_PROJECT/roles/smokeSecretWriter" --condition=None >/dev/null
    echo "Granted ${1}: can create/rotate smoke secrets with 'smokectl secret set', cannot read values." ;;
  revoke-secrets)
    gcloud projects remove-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:${1:?email}" \
      --role "projects/$GCP_PROJECT/roles/smokeSecretWriter" --all >/dev/null && echo "revoked" ;;

  grant-dojo)
    e="${1:?email}"
    [[ -n "$(gcloud config get-value account 2>/dev/null)" && "$(gcloud config get-value account 2>/dev/null)" != *gserviceaccount.com ]] \
      || die "run this in Cloud Shell (or wherever you're logged in to gcloud as yourself), not on the VM"; vm="projects/$GCP_PROJECT/zones/$VM_ZONE/instances/$VM_NAME"
    # IAP tunnel to the DefectDojo port ONLY (not 22: no SSH through IAP)
    if ! err="$(gcloud projects add-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" --role roles/iap.tunnelResourceAccessor \
          --condition "expression=destination.port == $DEFECTDOJO_PORT,title=defectdojo-iap-port-only" 2>&1 >/dev/null)"; then
      if grep -q "does not exist" <<< "$err"; then
        die "$e is not a Google account. IAP needs one: they can create a free Google account on this same address at https://accounts.google.com/signup ('Use my current email address instead'), or give you the Google account they already use."
      fi
      die "could not grant IAP access: $(grep -E 'ERROR' <<< "$err" | tail -1)"
    fi
    # gcloud looks the VM up by name before tunnelling: compute.instances.get on this one VM
    gcloud projects add-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" \
      --role "projects/$GCP_PROJECT/roles/smokeDojoTunnel" \
      --condition "expression=resource.name == '$vm',title=defectdojo-vm-lookup" >/dev/null
    cat <<MSG
Granted $e IAP access to DefectDojo (port $DEFECTDOJO_PORT only). Send them:
  1. Install the Google Cloud SDK (Windows: "Google Cloud SDK Shell"), then run once:  gcloud auth login
  2. Each time:  gcloud compute start-iap-tunnel $VM_NAME $DEFECTDOJO_PORT --local-host-port=localhost:$DEFECTDOJO_PORT --zone $VM_ZONE --project $GCP_PROJECT
  3. Leave that window open and browse $DEFECTDOJO_UI_URL
They also need a DefectDojo login: on the VM run  sudo $DEFECTDOJO_DIR/add-user.sh $e
MSG
    ;;
  revoke-dojo)
    e="${1:?email}"
    for r in roles/iap.tunnelResourceAccessor "projects/$GCP_PROJECT/roles/smokeDojoTunnel"; do
      if gcloud projects remove-iam-policy-binding "$GCP_PROJECT" --quiet --member "user:$e" --role "$r" --all >/dev/null 2>&1; then
        echo "removed $r"; else echo "no $r binding for $e"; fi
    done
    echo "Also deactivate their DefectDojo login (Users page, as admin) if they shouldn't sign in again." ;;
  dojo-tunnel)
    echo "Tunnel open while this runs; browse $DEFECTDOJO_UI_URL (Ctrl+C to close)."
    gcloud compute start-iap-tunnel "$VM_NAME" "$DEFECTDOJO_PORT" --local-host-port="localhost:$DEFECTDOJO_PORT" \
      --zone "$VM_ZONE" --project "$GCP_PROJECT" ;;
  dojo-status)
    if [[ -x "$DEFECTDOJO_DIR/status.sh" ]]; then sudo "$DEFECTDOJO_DIR/status.sh"
    else gcloud compute ssh "$VM_NAME" --zone "$VM_ZONE" --project "$GCP_PROJECT" --command "sudo $DEFECTDOJO_DIR/status.sh"; fi ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
