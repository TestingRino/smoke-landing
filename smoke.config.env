# smoke-landing configuration (non-secret; committed).
# Credentials live ONLY in /etc/smoke-landing/runner.env on the DevSecOps VM.

# GitHub account/org that owns the app repos. Empty = owner of this control repo.
OWNER="TestingRino"
# This control repo (used by bin/smokectl from your laptop).
CONTROL_REPO_NAME="smoke-landing"

# Google Cloud (fill in from the output of gcp/bootstrap.sh)
GCP_PROJECT="testingrino-smoke"
GCP_REGION="us-central1"
AR_REPO="smoke-apps"           # staging images (every build that passes the gate)
GCP_WIF_PROVIDER="projects/934359946111/locations/global/workloadIdentityPools/smoke-landing/providers/github"   # projects/<NUM>/locations/global/workloadIdentityPools/smoke-landing/providers/github
GCP_DEPLOYER_SA="smoke-deployer@testingrino-smoke.iam.gserviceaccount.com"    # smoke-deployer@<PROJECT>.iam.gserviceaccount.com

# Signing (Cloud KMS key; the private key never leaves KMS). Boundary pins keys/smoke-landing-signing.pub
KMS_KEY="gcpkms://projects/testingrino-smoke/locations/global/keyRings/smoke-landing/cryptoKeys/artifact-signing/cryptoKeyVersions/1"
RELEASE_REPO="smoke-release"   # Artifact Registry repo the boundary can READ; only promoted images land here
ATTEST_GATE_TYPE="https://github.com/TestingRino/smoke-landing/attestations/gate/v1"
ATTEST_STAGING_TYPE="https://github.com/TestingRino/smoke-landing/attestations/staging/v1"
ATTEST_RELEASE_TYPE="https://github.com/TestingRino/smoke-landing/attestations/release/v1"

# Which repos get auto-deployed by the poller
OPT_IN_TOPIC="smoke-deploy"   # repos with this GitHub topic are deployed on every new default-branch commit
ALL_REPOS="false"             # "true" = every non-archived, non-fork repo under OWNER (see policy/exclude.txt)
MAX_DISPATCH_PER_POLL="5"

# Lifecycle
TTL_DAYS="14"                 # janitor tears down services not redeployed within this many days
STATUS_CONTEXT="smoke-landing/gate"

# Pinned tool images (bump deliberately; review release notes)
GITLEAKS_IMAGE="zricethezav/gitleaks:v8.21.2"
SEMGREP_IMAGE="semgrep/semgrep:1.97.0"
TRIVY_IMAGE="aquasec/trivy:0.57.1"
SYFT_IMAGE="anchore/syft:v1.18.1"
ZAP_IMAGE="ghcr.io/zaproxy/zaproxy:stable"
COSIGN_IMAGE="gcr.io/projectsigstore/cosign:v2.4.1"
BUILDPACK_BUILDER="gcr.io/buildpacks/builder:google-22"
