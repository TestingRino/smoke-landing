# DevSecOps gate policy. A value of -1 means "report only, never block".
# Changes to this file are changes to your security bar: require PR review on it.

MAX_SECRETS=0                  # gitleaks (full git history) + trivy secret scan (source tree and built image)
MAX_SAST_ERROR=0               # semgrep findings with severity ERROR
MAX_SAST_WARNING=-1            # semgrep findings with severity WARNING
MAX_VULN_CRITICAL_FIXABLE=0    # CRITICAL CVEs in the built image that have a fixed version available
MAX_VULN_HIGH_FIXABLE=-1       # HIGH CVEs in the built image with a fix available
MAX_MISCONFIG_CRITICAL=0       # trivy IaC/Dockerfile misconfigurations
MAX_MISCONFIG_HIGH=-1

SEMGREP_RULESETS="p/default p/owasp-top-ten"

# Post-deploy DAST (OWASP ZAP baseline, passive scan against the live URL)
ZAP_ENABLED=true               # per-app override: `zap: false` in .smoke.yml
ZAP_BLOCK_ON_HIGH=false        # true = revoke public access if ZAP reports High-risk alerts

# Resource caps that .smoke.yml cannot exceed
MAX_INSTANCES_CAP=3
