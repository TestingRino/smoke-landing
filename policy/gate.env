# DevSecOps gate policy. A value of -1 means "report only, never block".
# Changes to this file are changes to your security bar: require PR review on it.
#
# Policy: ALL critical and high issues block. A finding with no fix available still blocks
# unless it gets a time-boxed exception in policy/exceptions/<repo>/trivyignore, e.g.
#   CVE-2024-12345 exp:2027-01-31   # no upstream fix; not reachable (ticket SEC-42)

MAX_SECRETS=0                  # gitleaks (full git history) + trivy secret scan (source tree and built image)
MAX_SAST_ERROR=0               # semgrep ERROR (= high)
MAX_SAST_WARNING=-1            # semgrep WARNING (= medium): reported, filed in DefectDojo, not blocking
MAX_VULN_CRITICAL=0            # CRITICAL CVEs in the built image
MAX_VULN_HIGH=0                # HIGH CVEs in the built image
VULN_COUNT_UNFIXED=true        # true = unfixed CVEs count too (use exceptions with exp: dates)
MAX_MISCONFIG_CRITICAL=0       # trivy IaC/Dockerfile misconfigurations
MAX_MISCONFIG_HIGH=0

SEMGREP_RULESETS="p/default p/owasp-top-ten"

# GitHub issues for blocking findings (deduplicated; auto-closed when fixed)
FILE_ISSUES=true
MAX_NEW_ISSUES_PER_RUN=25

# Post-deploy DAST against staging (OWASP ZAP baseline, passive)
ZAP_ENABLED=true               # per-app override: `zap: false` in .smoke.yml
ZAP_BLOCK_ON_HIGH=true         # High-risk ZAP alerts revoke public access and block release

# Resource caps that .smoke.yml cannot exceed
MAX_INSTANCES_CAP=3
