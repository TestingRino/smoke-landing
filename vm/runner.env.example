# /etc/smoke-landing/runner.env (mode 0640 root:smoke). Read by the pipeline scripts on the VM only.

# Fine-grained PAT, resource owner = TestingRino, "All repositories":
#   Contents: read, Metadata: read, Commit statuses: read & write
GH_APPS_TOKEN=

# Infisical machine identity (Universal Auth) with the read-only *Viewer* role on the smoke project
INFISICAL_URL=http://127.0.0.1:8080
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
