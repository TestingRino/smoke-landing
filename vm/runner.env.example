# /etc/smoke-landing/runner.env (mode 0640 root:smoke). Read by the pipeline scripts on the VM only.

# Fine-grained PAT, resource owner = TestingRino, "All repositories":
#   Contents: read, Metadata: read, Commit statuses: read & write, Issues: read & write
GH_APPS_TOKEN=

# DefectDojo (findings tracker): written by vm/defectdojo/setup.sh. Non-admin user "smoke-pipeline",
# scoped to the smoke-landing product type. Never paste these into GitHub.
DEFECTDOJO_URL=http://127.0.0.1:8088
DEFECTDOJO_TOKEN=
